<Project>

  <PropertyGroup>
    <!--
      CI では、タグ(v2.0.0 など)のときはタグのバージョンを -p:Version で指定し、
      それ以外は -p:VersionSuffix=ci.N でプレリリース版(2.0.0-ci.N)にする。
      アセンブリのバージョンがここから決まり、PackageValidationBaselineVersion 以上である必要がある
    -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <Authors>cssho</Authors>
    <Product>ZipConvertCustomerBarCode</Product>
    <Copyright>Copyright (c) 2015 cssho</Copyright>
  </PropertyGroup>

  <!-- NuGet パッケージ -->
  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cssho/ZipConvertCustomerBarCode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cssho/ZipConvertCustomerBarCode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>customer-barcode;barcode;japan-post;postal-code;zipcode;カスタマバーコード;郵便番号</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      パッケージ作成時に、net8.0 版が netstandard2.0 版の公開 API をすべて持っているかを確認する
      (#if で net8.0 版から API が欠けるとエラー CP0002。net8.0 版にだけ API を足すのは検出しない)
    -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      nuget.org に公開済みのバージョンと比べて、公開 API を削除・変更していないかも確認する
      (破壊的変更をするメジャーバージョンアップでは、この基準を外すか更新する)
    -->
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
